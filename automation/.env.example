# automation/.env としてコピーして使う。このファイル自体(.env)はコミットしない。
# .env.example (このファイル) はテンプレートなので実際の値を書かずコミットしてよい。

# --- ライブドアブログ ---
LIVEDOOR_BLOG_ID=ssyatabe2
# login_helper.py でAPIキーを取得する時だけ一時的に使う。取得後は削除してよい。
LIVEDOOR_LOGIN_PASSWORD=
# AtomPub投稿(atompub_client.py)で使う本命のキー。ログインパスワードとは別物。
# ブログ設定→「Atom API」→「Atom Pub用パスワード」から取得する。
LIVEDOOR_ATOMPUB_KEY=

# --- サンドボックス外(ローカルMac等)でChromiumの場所を明示したい場合のみ設定 ---
# HERMES_CHROMIUM_PATH=
